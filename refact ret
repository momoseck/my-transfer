}

@Component
public class ReturnFileProcessorRegistry {

    private final Map<ReturnFileType, ReturnFileProcessor> processors;

    public ReturnFileProcessorRegistry(List<ReturnFileProcessor> processorList) {
        this.processors = processorList.stream()
                .collect(Collectors.toMap(ReturnFileProcessor::supports, Function.identity()));
    }

    public ReturnFileProcessor get(ReturnFileType type) {
        ReturnFileProcessor processor = processors.get(type);
        if (processor == null) {
            throw new UnsupportedReturnFileTypeException("Type non supporté : " + type);
        }
        return processor;
    }
}

